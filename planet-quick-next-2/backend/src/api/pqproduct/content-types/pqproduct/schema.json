{
  "kind": "collectionType",
  "collectionName": "pqproducts",
  "info": {
    "singularName": "pqproduct",
    "pluralName": "pqproducts",
    "displayName": "pqproduct",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "pqproductname": {
      "type": "string"
    },
    "pqproductavailability": {
      "type": "string"
    },
    "pqproductimage": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "pqproductprice": {
      "type": "decimal"
    },
    "pqstore_id": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::pqstore.pqstore"
    },
    "variantOf": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::pqproduct.pqproduct",
      "inversedBy": "variants"
    },
    "variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::pqproduct.pqproduct",
      "mappedBy": "variantOf"
    }
  }
}
